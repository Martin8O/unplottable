{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["D:\\Projekty\\_brain\\hooks\\session_rules.py"],
            "timeout": 10,
            "statusMessage": "Loading standing rules"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["D:\\Projekty\\_brain\\hooks\\commit_guard.py"],
            "if": "Bash(git commit *)",
            "timeout": 15,
            "statusMessage": "Checking the commit"
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["D:\\Projekty\\_brain\\hooks\\commit_guard.py"],
            "if": "PowerShell(git commit *)",
            "timeout": 15,
            "statusMessage": "Checking the commit"
          }
        ]
      }
    ]
  }
}
